# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
JOBSPIPE_API_KEY=

# Local Server Configuration
PORT=8080

# Google OAuth2 Credentials (Read-Only Gmail Access)
# Authorized redirect URI in Google Cloud Console must match:
# http://localhost:8080/api/gmail/callback (or http://localhost:8081/api/gmail/callback if using port 8081)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/callback
